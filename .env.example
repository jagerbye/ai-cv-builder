# Copy to .env and fill in. Never commit .env.
# ANTHROPIC_API_KEY is optional at boot: without it the app starts, and
# generation fails with a configuration error (spec.md F-010).
ANTHROPIC_API_KEY=
# Endpoint of an Anthropic-compatible proxy (must speak the Messages API).
# Host plus an optional path prefix, WITHOUT /v1 — the SDK appends /v1/messages
# itself, so a base ending in /v1 produces /v1/v1/messages and 404s.
# Leave empty to use the Anthropic API itself.
# ANTHROPIC_BASE_URL=
# Model id override; empty means the built-in default (see api/src/llm/config.ts).
# ANTHROPIC_MODEL=
# Max tokens of ONE response, and the token budget of ONE job (ADR-021). Empty means the defaults.
# ANTHROPIC_MAX_OUTPUT_TOKENS=
# ANTHROPIC_TOKEN_BUDGET_PER_JOB=
# Host-side address for running the api outside docker compose.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_cv_builder

# Host port for the web container. 5173 is vite's default and is often
# already taken by another project; override here if 5273 clashes too.
WEB_PORT=5273
