  "icons": {
    "set": "inline SVG, hand-written into web/src/icons; no icon package (architecture.md §1)",
    "stroke": "1.75px",
    "sizes": {
      "sm": "16px",
      "md": "18px",
      "lg": "24px",
      "xl": "32px"
    },
    "rule": "An icon earns its place only on a control that repeats per row AND has no room for a label. Everything else is a text label: buttons say what they do, errors are a red border plus a red caption, states are words. Adding an icon to this list is a design decision, not a detail.",
    "needed": [
      "trash"
    ],
    "cut": "Cut from 18 to 1 by the Orchestrator on 2026-10-28. Dropped: question-circle, check, check-circle, x, x-circle, upload, file-text, quote, download, plus, trash-adjacent arrows (arrow-up, arrow-down), chevron-down, eye, eye-off, alert-triangle, refresh. Each was decoration beside a label that already said the same thing; reorder stayed as Move up / Move down text buttons, which the spec had already chosen for keyboard access."
  },
  "design_principles": [
    "The CV is paper; the UI is the desk. The sheet is the only pure-white surface; everything else sits on the warm page colour.",
    "One accent, used only for things the user can do. Amber is reserved for open questions and never used for errors.",
    "Questions live beside their field, never in a pile. The amber left rule on a field and the amber card are the same object seen twice.",
    "Nothing pretends: no percentage bars, no 'almost done', no invented facts. Progress names the stage and the elapsed time.",
    "Calm over clever: no gradients, no large radii, no decorative illustration, motion only to confirm (save) or to show liveness (current stage).",
    "Mobile first, literally: every component is specified at 375px and widened; 44px targets and 14px minimum text are tokens, not reminders."
  ]
}
